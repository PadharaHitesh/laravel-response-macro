{
    "name": "hiteshpadhara/laravel-response-macro",
    "description": "Adds a Response::api() macro for uniform JSON APIs",
    "type": "library",
    "keywords": ["laravel", "api", "response", "json", "macro"],
    "license": "MIT",
    "authors": [
        {
            "name": "Hitesh Padhara",
            "email": "your-email@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/validation": "^10.0|^11.0|^12.0",
        "illuminate/pagination": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.35|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Hiteshpadhara\\ResponseMacro\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hiteshpadhara\\ResponseMacro\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hiteshpadhara\\ResponseMacro\\ResponseMacroServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
